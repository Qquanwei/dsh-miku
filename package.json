{
  "name": "dsh-miku",
  "version": "1.0.0",
  "private": true,
  "description": "Hatsune Miku module artwork as the DSH sidebar background, with per-session binding or a fixed image and an opacity setting.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qquanwei/dsh-miku.git"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./assets/*": "./assets/*"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "assets", "market"],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
